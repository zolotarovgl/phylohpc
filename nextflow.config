profiles {

    local {
        process {
            executor = 'local'
            cpus = 8
            memory = '4 GB'
            time = '1h'
            beforeScript = 'export PYTHONNOUSERSITE=1'
            env.PYTHONNOUSERSITE = '1'
        }
    }

    slurm {
        process {
            executor = 'slurm'
            queue = 'genoa64'
            clusterOptions = '--qos=normal'
            cache = 'lenient'
            cpus = 1
            memory = '4G'
            time = '4h'
            beforeScript = 'export PYTHONNOUSERSITE=1'
            env.PYTHONNOUSERSITE = '1'
        }

        withLabel: big_mem {
            clusterOptions = '--qos=long'
            memory = '60G'
            time = '12h'
        }

        withLabel: big_cpus {
            cpus = 8
            memory = '20G'
            time = '6h'
        }
    }

    // Profile-driven method tuning, restored round 2 (2026-08-18) in LOWERCASE only --
    // never uppercase, see canonical()'s comment in step2.nf. A profile overriding a
    // canonical() default is fine and is the whole point of a profile; what is NOT fine
    // (round 1's bug) is *defaulting* these in the plain params{} block below, which
    // makes containsKey(lower) true before any user input. Values match cf61d23.
    fast {
        params {
            mafft_opt    = ""              // default MAFFT
            tree_method  = "fasttree"
            max_spr      = 2
            ncpu_generax = 8
        }
    }

    precise {
        params {
            mafft_opt    = "--maxiterate 1000 --localpair"  // L-INS-i
            tree_method  = "iqtree2"
            max_spr      = 3
            ncpu_generax = 2
        }
    }
}


trace {
  overwrite = true
}

report {
  overwrite = true
}

timeline {
  overwrite = true
}

// The ten science parameters that used to live here (species_tree, refnames, refsps,
// subs_model, max_spr, ncpu_generax, tree_method, mafft_opt, iqtree2_model, outdir) do
// NOT get top-level defaults in this block any more (round 1, 2026-08-18) -- their
// defaults live ONLY as the third argument to canonical(name, upper, default) in
// step2.nf. Defaulting them here made `params.containsKey(lower)` true from config
// load alone, before any user input, which made canonical()'s legacy-uppercase branch
// permanently unreachable.
//
// The four the fast/precise profiles legitimately need to override (mafft_opt,
// tree_method, max_spr, ncpu_generax) are set in LOWERCASE inside those profile blocks
// above -- a profile overriding a default is the point of a profile, and it does not
// reintroduce the bug because it is the SAME key family (lowercase) canonical() already
// prefers.
//
// The uppercase names (SPECIES_TREE, REFNAMES, REFSPECIES, SUBS_MODEL, MAX_SPR,
// NCPU_GENERAX, TREE_METHOD, MAFFT_OPT, IQTREE2_MODEL) must NEVER be defined anywhere in
// this file, in any profile -- canonical() in step2.nf now treats their mere presence
// in `params` as a hard error (round 2, 2026-08-18), precisely so that
// `containsKey(upper)` stays a reliable "the user passed a legacy flag" signal.
params {
    genefam_info  = "genefam.csv"
    infasta       = "data/input.fasta"
    pfam_db       = "/users/asebe/xgraubove/data/pfam/Pfam-A.hmm"
    domain_expand = 30
    s1_ncpu       = 4
    search_dir    = "results/search"
    cluster_dir   = "results/clusters"
    max_n         = 2000
    s2_ncpu       = 4
    s2_inflation  = 1.1
}
