profiles {

    local {
        process {
            executor = 'local'
            cpus = 8
            memory = '4 GB'
            time = '1h'
            beforeScript = 'export PYTHONNOUSERSITE=1'
            env.PYTHONNOUSERSITE = '1'
        }
    }

    slurm {
        process {
            executor = 'slurm'
            queue = 'genoa64'
            clusterOptions = '--qos=normal'
            cache = 'lenient'
            cpus = 1
            memory = '4G'
            time = '4h'
            beforeScript = 'export PYTHONNOUSERSITE=1'
            env.PYTHONNOUSERSITE = '1'
        }

        withLabel: big_mem {
            clusterOptions = '--qos=long'
            memory = '60G'
            time = '12h'
        }

        withLabel: big_cpus {
            cpus = 8
            memory = '20G'
            time = '6h'
        }
    }

    fast {
        params {
            mafft_opt   = ""              // default MAFFT
            tree_method = "fasttree"
            max_spr     = 2
            ncpu_generax = 8
        }
    }

    precise {
        params {
            mafft_opt   = "--maxiterate 1000 --localpair"  // L-INS-i
            tree_method = "iqtree2"
            max_spr     = 3
            ncpu_generax = 2
        }
    }
}


trace {
  overwrite = true
}

report {
  overwrite = true
}

timeline {
  overwrite = true
}

params {
    genefam_info  = "genefam.csv"
    infasta       = "data/input.fasta"
    pfam_db       = "/users/asebe/xgraubove/data/pfam/Pfam-A.hmm"
    domain_expand = 30
    s1_ncpu       = 4
    search_dir    = "results/search"
    cluster_dir   = "results/clusters"
    max_n         = 2000
    s2_ncpu       = 4
    s2_inflation  = 1.1
    iqtree2_model = "TEST"
    refsps        = "Mmus"
    refnames      = "data/Mmus_gene_names.csv"
    // LEGACY. The GeneRax channel used to read this and ignore --species_tree, which is
    // how the 2026-08-14 run got the unresolved tree. step2.nf now prefers --species_tree
    // and keeps this only as a fallback. Do not point it at a multifurcating tree.
    species_tree  = "data/species_tree.newick"
    subs_model    = "LG"
}
