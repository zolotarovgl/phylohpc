profiles {

    local {
        process {
            executor = 'local'
            cpus = 8
            memory = '4 GB'
            time = '1h'
            beforeScript = 'export PYTHONNOUSERSITE=1'
            env.PYTHONNOUSERSITE = '1'
        }
    }

    slurm {
        process {
            executor = 'slurm'
            queue = 'genoa64'
            clusterOptions = '--qos=normal'
            cache = 'lenient'
            cpus = 1
            memory = '4G'
            time = '4h'
            beforeScript = 'export PYTHONNOUSERSITE=1'
            env.PYTHONNOUSERSITE = '1'
        }

        withLabel: big_mem {
            clusterOptions = '--qos=long'
            memory = '60G'
            time = '12h'
        }

        withLabel: big_cpus {
            cpus = 8
            memory = '20G'
            time = '6h'
        }
    }

    // 'fast'/'precise' used to set MAFFT_OPT/TREE_METHOD/MAX_SPR/NCPU_GENERAX here.
    // Removed 2026-08-18 (config-provenance ruling): any value in this file, upper- or
    // lowercase, is present in `params` from config load alone and makes canonical()'s
    // containsKey() checks true unconditionally, which is exactly the dead-shim bug this
    // refactor removes. Reintroducing per-profile science params needs a mechanism that
    // doesn't run through containsKey() on the plain params map -- not done here.
    fast {
    }

    precise {
    }
}


trace {
  overwrite = true
}

report {
  overwrite = true
}

timeline {
  overwrite = true
}

// The ten science parameters that used to live here (species_tree, refnames, refsps,
// subs_model, max_spr, ncpu_generax, tree_method, mafft_opt, iqtree2_model, outdir) were
// REMOVED 2026-08-18. Keeping them here with lowercase defaults made
// `params.containsKey(lower)` true from config load alone, before any user input, which
// made canonical()'s legacy-uppercase branch in step2.nf permanently unreachable -- a
// user passing SPECIES_TREE got it silently discarded with no warning. Their defaults
// now live ONLY as the third argument to canonical(name, upper, default) in step2.nf.
// Do not re-add them here -- that reintroduces the same dead shim.
//
// The uppercase names (SPECIES_TREE, REFNAMES, REFSPECIES, SUBS_MODEL, MAX_SPR,
// NCPU_GENERAX, TREE_METHOD, MAFFT_OPT, IQTREE2_MODEL) are not defined anywhere in this
// file any more; canonical() in step2.nf falls back to them only when the user sets one
// via -params-file/CLI, and warns when it does.
params {
    genefam_info  = "genefam.csv"
    infasta       = "data/input.fasta"
    pfam_db       = "/users/asebe/xgraubove/data/pfam/Pfam-A.hmm"
    domain_expand = 30
    s1_ncpu       = 4
    search_dir    = "results/search"
    cluster_dir   = "results/clusters"
    max_n         = 2000
    s2_ncpu       = 4
    s2_inflation  = 1.1
}
