// Resource tuning for step1/step2 at this project's scale.
//
// Source: Bonita van Waardenburg's phylohpc-fix working tree
// (/users/project/bca_009518_no_backup/bvanwaardenburg/pkgs/phylohpc-fix, on top of 45b57fd),
// lifted into a config so it can be applied without merging her step2.nf over ours -- ours
// carries GXSUP, PVM --skiproot and the POSSVM support postprocess, which her tree predates.
//
// Apply with:  submit_nf.sh ... step2.nf -c conf/resources_bvw.config ...
// A `withName:` block here OVERRIDES the directive in the process body, so these values win
// over whatever step2.nf declares.
//
// ⚠ resources.tsv per-family overrides (`res[id]?.aln_mem` etc.) are NOT honoured from here:
// `res` is a script-level variable in step2.nf and a config closure cannot see it. Applying
// this config therefore replaces the per-family table with the family-size tiers below. Verified 2026-08-28 that a config closure can read a
// process input (nseq), so the family-size tiers work from here.
//
// ⚠ REQUIRES step2.nf to thread `nseq` into ALN and PHY:
//     .map { id, fasta -> tuple(id, fasta, countFastaSeqs(fasta)) }
//     .filter { id, fasta, nseq -> nseq >= 2 }
//   and the matching `val(nseq)` in each process input/output. Without it these closures
//   fail at runtime with "No such variable: nseq" -- they do NOT silently fall back.
//
// ⚠ NOT expressible in config, still needs a step2.nf change if wanted:
//   * the IQ-TREE checkpoint stash in PHY (SLURM --signal=B:USR2@180, traps on USR2/TERM,
//     `gzip -t` validation before installing, background+wait so the trap can fire).
//     That is the piece that would rescue the 7 giant TF families currently losing all
//     work on every 24 h timeout (exit 140 == 128+SIGUSR2).
//
// ⚠ maxRetries is deliberately ONE HIGHER than the errorStrategy closure's threshold. If the
//   closure still returns 'retry' on the attempt where maxRetries is reached, the 'ignore'
//   branch is never evaluated and the whole run terminates instead of skipping the family.

process {

    // ---- step2: alignment -------------------------------------------------------------
    // L-INS-i (--localpair) keeps local-homology data for all N(N-1)/2 pairs, so memory is
    // ~O(N^2 * L) and outruns the sequence count. Measured (BvW): adh.fibronectin.HG15,
    // 114 seqs, median 252 aa, max 4504, peaked at 4.19 GB -- so the 100-500 band needs its
    // own tier and a flat 4 GB floor OOMs families that look small.
    withName: ALN {
        memory = { (nseq > 1000 ? 48.GB : nseq > 500 ? 32.GB : nseq > 100 ? 16.GB : 4.GB) * task.attempt }
        time   = { (nseq > 1000 ? 24.h  : nseq > 500 ? 12.h  : 4.h) * task.attempt }
        clusterOptions = { (nseq > 500 || task.attempt > 1) ? '--qos=long' : '--qos=normal' }
        errorStrategy  = { task.attempt <= 10 ? 'retry' : 'ignore' }
        maxRetries     = 11
    }

    // ---- step2: gene trees ------------------------------------------------------------
    // IQ-TREE2 with ModelFinder holds many candidate models at once; cost grows with
    // taxa x sites. Double per retry -- a linear ladder from 300 MB tops out at 3 GB after
    // 10 attempts and never reaches what a big family needs. ModelFinder alone fits ~90
    // models before the search starts, so a 1 h floor times out on attempt 1 and discards
    // all of that work.
    withName: PHY {
        memory = { def m = (nseq > 1000 ? 16.GB : nseq > 500 ? 8.GB : nseq > 200 ? 4.GB : 1.GB) * Math.pow(2, task.attempt - 1)
                   m > 32.GB ? 32.GB : m }
        time   = { (nseq > 1000 ? 24.h : nseq > 500 ? 12.h : 4.h) * task.attempt }
        errorStrategy = { task.attempt <= 10 ? 'retry' : 'ignore' }
        maxRetries    = 11
    }

    // ---- step2: GeneRax ---------------------------------------------------------------
    // 30 min was too short a base: the exit-140s (SIGUSR2, i.e. the task hit its own time
    // limit) on the large TF families were mostly this.
    withName: GR_watcher {
        maxRetries = 6
    }

    // ---- step1 ------------------------------------------------------------------------
    // hmmsearch scans the whole concatenated proteome against Pfam-A and the python side
    // holds the domain tables in memory, so cost tracks input.fasta size, not family size.
    withName: SEARCH {
        memory = { def m = 4.GB * Math.pow(2, task.attempt - 1); m > 128.GB ? 128.GB : m }
        time   = { 30.min + (task.attempt - 1) * 1.h }
        // 'finish' not 'terminate': let in-flight families complete so one bad family does
        // not discard the rest. The run still exits non-zero, so failure is not silent.
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'finish' }
        maxRetries    = 6
    }

    // DIAMOND's footprint is dominated by its block/index defaults rather than the query, so
    // fasta size is a weak predictor and the floor carries most of the weight. Measured
    // (BvW): sig.Pkinase peaked at 8.5 GB on a fasta well under the 20 MB tier, so a floor
    // below ~16 GB leaves no headroom. MCL on the hit graph is what scales with family size.
    // This supersedes the extra.config workaround described in PROVENANCE.md.
    withName: CLUSTER {
        memory = { def m = (fbytes > 100000000 ? 48.GB : fbytes > 20000000 ? 32.GB : 16.GB) * Math.pow(2, task.attempt - 1)
                   m > 128.GB ? 128.GB : m }
        time   = { 30.min + (task.attempt - 1) * 2.h }
        errorStrategy = { task.attempt <= 5 ? 'retry' : 'finish' }
        maxRetries    = 6
    }
}
